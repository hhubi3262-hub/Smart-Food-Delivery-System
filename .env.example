# ============================================
# SERVER CONFIGURATION
# ============================================
NODE_ENV=development
PORT=5000
API_VERSION=v1

# ============================================
# DATABASE CONFIGURATION (MySQL)
# ============================================
DB_HOST=localhost
DB_PORT=3306
DB_NAME=afamia_restaurant
DB_USER=root
DB_PASSWORD=
DB_DIALECT=mysql

# Alternative: PostgreSQL (for Neon)
# DATABASE_URL=postgresql://user:password@host:5432/database

# ============================================
# JWT AUTHENTICATION
# ============================================
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRE=7d
JWT_COOKIE_EXPIRE=7

# ============================================
# BUSINESS INFORMATION
# ============================================
BUSINESS_LEGAL_NAME=AFAMIA CAFE AND RESTAURANT (S.P.S - L.L.C)
BUSINESS_BRAND=KEDIR
BUSINESS_LICENSE=133469
BUSINESS_OWNER=Kedir Ahmed Ebrahim
BUSINESS_MANAGER=Faiza Yimam Nurye

# ============================================
# CONTACT INFORMATION
# ============================================
BUSINESS_PHONE=+971566407830
BUSINESS_WHATSAPP=+971566407830
BUSINESS_EMAIL=kedir6679@gmail.com
BUSINESS_ADDRESS=Shop No. 64-65, Rashideya 1, Ajman, UAE

# ============================================
# LOCATION COORDINATES
# ============================================
BUSINESS_LAT=25.4052
BUSINESS_LNG=55.5136

# ============================================
# COMPLIANCE & REGULATIONS
# ============================================
VAT_PERCENTAGE=5
OPERATING_HOURS_END=00:00
MIN_NON_SMOKER_AREA=50
DED_ADVERTISING_PERMIT_REQUIRED=true

# ============================================
# CLOUDINARY (IMAGE STORAGE)
# ============================================
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=afamia-restaurant

# ============================================
# STRIPE PAYMENT
# ============================================
STRIPE_PUBLIC_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ============================================
# GOOGLE MAPS API
# ============================================
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# ============================================
# EMAIL CONFIGURATION (SMTP)
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
EMAIL_FROM=AFAMIA CAFE <noreply@afamia.ae>

# ============================================
# WHATSAPP API
# ============================================
WHATSAPP_API_URL=https://graph.facebook.com/v17.0
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_access_token
WHATSAPP_VERIFY_TOKEN=your_verify_token

# ============================================
# FRONTEND URL
# ============================================
CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5173/admin

# ============================================
# CORS SETTINGS
# ============================================
CORS_ORIGIN=http://localhost:5173

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# FILE UPLOAD LIMITS
# ============================================
MAX_FILE_SIZE=5242880
MAX_FILES=10

# ============================================
# SESSION & COOKIES
# ============================================
SESSION_SECRET=your_session_secret
COOKIE_SECRET=your_cookie_secret

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=info
LOG_FILE=logs/app.log

# ============================================
# REDIS (OPTIONAL - FOR CACHING)
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ============================================
# DEPLOYMENT URLS (PRODUCTION)
# ============================================
# PRODUCTION_API_URL=https://api.afamia.ae
# PRODUCTION_CLIENT_URL=https://afamia.ae
